<script>
const $ = (sel, root=document) => root.querySelector(sel);
const $$ = (sel, root=document) => Array.from(root.querySelectorAll(sel));

function norm(s){
  return String(s || '')
    .toLowerCase()
    .replaceAll(' ','')
    .replaceAll('×','*')
    .replaceAll('−','-')
    .replaceAll('÷','/')
    .replaceAll('√','sqrt')
    .replaceAll('|','abs')
    .replace(/\(([^()]*)\)/g,'$1')
    .trim();
}
function accepted(input, answers){
  const n = norm(input);
  return answers.some(a => norm(a) === n);
}

const squareGrid = $('#squareGrid');
for(let i=1;i<=16;i++){
  const div=document.createElement('div');
  div.className='mini-card';
  div.innerHTML=`<div class="num formula">${i}² = ${i*i}</div><div class="label">√${i*i} = ${i}</div>`;
  squareGrid.appendChild(div);
}

const sets = {
  setA: [
    {type:'mc', skill:'Concept', q:'√64 มีค่าเท่าไร?', choices:['-8','8','±8','32'], ans:'8', sol:'√64 หมายถึงรากที่สองหลัก จึงตอบ 8 ไม่ใช่ ±8'},
    {type:'mc', skill:'Concept', q:'ข้อใดเป็น perfect square?', choices:['72','81','98','120'], ans:'81', sol:'81 = 9² จึงเป็น perfect square'},
    {type:'mc', skill:'Concept', q:'√0 มีค่าเท่าไร?', choices:['ไม่มีค่า','0','1','ไม่สามารถกำหนดได้'], ans:'0', sol:'เพราะ 0² = 0 และ √0 = 0'},
    {type:'mc', skill:'Concept', q:'จำนวนใดอยู่ระหว่าง √50?', choices:['6 และ 7','7 และ 8','8 และ 9','49 และ 64'], ans:'7 และ 8', sol:'7² = 49 และ 8² = 64 ดังนั้น √50 อยู่ระหว่าง 7 และ 8'},
    {type:'mc', skill:'Concept', q:'ถ้า √n = 13 แล้ว n มีค่าเท่าไร?', choices:['26','39','169','196'], ans:'169', sol:'n = 13² = 169'}
  ],
  setB: [
    {type:'input', skill:'Simplify', q:'จัดรูป √48 ให้ง่ายที่สุด', ans:['4√3','4sqrt3','4sqrt(3)'], sol:'√48 = √(16×3) = 4√3'},
    {type:'input', skill:'Simplify', q:'จัดรูป √72 ให้ง่ายที่สุด', ans:['6√2','6sqrt2','6sqrt(2)'], sol:'√72 = √(36×2) = 6√2'},
    {type:'input', skill:'Simplify', q:'จัดรูป √125 ให้ง่ายที่สุด', ans:['5√5','5sqrt5','5sqrt(5)'], sol:'√125 = √(25×5) = 5√5'},
    {type:'input', skill:'Simplify', q:'จัดรูป √200 ให้ง่ายที่สุด', ans:['10√2','10sqrt2','10sqrt(2)'], sol:'√200 = √(100×2) = 10√2'},
    {type:'input', skill:'Simplify', q:'จัดรูป √288 ให้ง่ายที่สุด', ans:['12√2','12sqrt2','12sqrt(2)'], sol:'√288 = √(144×2) = 12√2'},
    {type:'input', skill:'Simplify', q:'คำนวณ √(18/50)', ans:['3/5','0.6'], sol:'√(18/50) = √(9/25) = 3/5'},
    {type:'input', skill:'Simplify', q:'คำนวณ √0.49', ans:['0.7','7/10'], sol:'0.49 = 49/100 ดังนั้น √0.49 = 7/10 = 0.7'},
    {type:'input', skill:'Simplify', q:'คำนวณ √(7²)', ans:['7'], sol:'√(7²) = |7| = 7'}
  ],
  setC: [
    {type:'input', skill:'Multiply', q:'คำนวณ √12 × √3', ans:['6'], sol:'√12×√3 = √36 = 6'},
    {type:'input', skill:'Multiply', q:'คำนวณ √5 × √20', ans:['10'], sol:'√5×√20 = √100 = 10'},
    {type:'input', skill:'Divide', q:'คำนวณ √75 ÷ √3', ans:['5'], sol:'√75÷√3 = √25 = 5'},
    {type:'input', skill:'Multiply', q:'คำนวณ √8 × √18', ans:['12'], sol:'√8×√18 = √144 = 12'},
    {type:'input', skill:'Divide', q:'คำนวณ √50 ÷ √2', ans:['5'], sol:'√50÷√2 = √25 = 5'},
    {type:'input', skill:'Multiply', q:'คำนวณ (2√3)(5√12)', ans:['60'], sol:'(2√3)(5√12) = 10√36 = 60'},
    {type:'input', skill:'Multiply', q:'คำนวณ √45 × √20', ans:['30'], sol:'√45×√20 = √900 = 30'},
    {type:'input', skill:'Divide', q:'คำนวณ √98 ÷ √2', ans:['7'], sol:'√98÷√2 = √49 = 7'}
  ],
  setD: [
    {type:'input', skill:'Power', q:'คำนวณ √((-7)²)', ans:['7'], sol:'√((-7)²) = |-7| = 7'},
    {type:'input', skill:'Absolute Value', q:'ถ้า x < 0 แล้ว √x² เท่ากับอะไร?', ans:['-x'], sol:'เพราะ √x² = |x| และเมื่อ x < 0 จะได้ |x| = -x'},
    {type:'input', skill:'Power', q:'คำนวณ (√6)²', ans:['6'], sol:'(√6)² = 6'},
    {type:'input', skill:'Power', q:'คำนวณ √(3⁴)', ans:['9'], sol:'3⁴ = 81 ดังนั้น √81 = 9'},
    {type:'input', skill:'Absolute Value', q:'จัดรูป √(a²b²)', ans:['|ab|','abs(ab)','absoluteab'], sol:'√(a²b²) = √((ab)²) = |ab|'},
    {type:'input', skill:'Variable', q:'ถ้า x ≥ 0 จัดรูป √(81x²)', ans:['9x'], sol:'√(81x²) = 9|x| และเมื่อ x ≥ 0 จะได้ 9x'}
  ],
  setE: [
    {type:'input', skill:'Counting', q:'มี perfect squares กี่จำนวนตั้งแต่ 1 ถึง 1000?', ans:['31'], sol:'จำนวนคือ ⌊√1000⌋ = 31 เพราะ 31² = 961 และ 32² = 1024'},
    {type:'input', skill:'Factorization', q:'หาจำนวนเต็มบวก k ที่น้อยที่สุดทำให้ 72k เป็น perfect square', ans:['2'], sol:'72 = 2³×3² ต้องเติม 2 อีกหนึ่งตัว จึงได้ k = 2'},
    {type:'input', skill:'Floor sqrt', q:'จำนวนเต็มมากที่สุด n ที่ทำให้ n² ≤ 2026 คือเท่าไร?', ans:['45'], sol:'45² = 2025 และ 46² = 2116 ดังนั้น n = 45'},
    {type:'mc', skill:'Check square', q:'98765 เป็น perfect square หรือไม่?', choices:['เป็น เพราะใกล้ 314²','ไม่เป็น เพราะ 314² < 98765 < 315²','เป็น เพราะลงท้ายด้วย 5','สรุปไม่ได้'], ans:'ไม่เป็น เพราะ 314² < 98765 < 315²', sol:'314² = 98596 และ 315² = 99225 จึงไม่มีจำนวนเต็มที่ยกกำลังสองได้ 98765'},
    {type:'mc', skill:'Number Theory', q:'เงื่อนไขของ n ที่เป็น perfect square จาก prime factorization คือข้อใด?', choices:['เลขชี้กำลังทุกตัวเป็นเลขคี่','เลขชี้กำลังทุกตัวเป็นเลขคู่','ผลบวกเลขชี้กำลังเป็นเลขคู่','มีจำนวนเฉพาะอย่างน้อย 2 ตัว'], ans:'เลขชี้กำลังทุกตัวเป็นเลขคู่', sol:'perfect square ต้องมี exponent ของ prime ทุกตัวเป็นเลขคู่'},
    {type:'input', skill:'Inequality', q:'มีจำนวนเต็ม x กี่จำนวนที่ทำให้ x² ≤ 144?', ans:['25'], sol:'x อยู่ตั้งแต่ -12 ถึง 12 รวมทั้งหมด 25 จำนวน'},
    {type:'mc', skill:'Compare', q:'ข้อใดถูกต้อง?', choices:['√50 < 7','√50 = 7','√50 > 7','สรุปไม่ได้'], ans:'√50 > 7', sol:'เพราะ 7² = 49 < 50 ดังนั้น √50 > 7'},
    {type:'input', skill:'Factorization', q:'ถ้า n = 2⁵×3²×5 จงหา m น้อยที่สุดที่ทำให้ nm เป็น perfect square', ans:['10'], sol:'เลขชี้กำลังที่เป็นคี่คือ 2⁵ และ 5¹ ต้องคูณด้วย 2×5 = 10'},
    {type:'input', skill:'Floor sqrt', q:'⌊√(10⁸ - 1)⌋ มีค่าเท่าไร?', ans:['9999'], sol:'10⁸ - 1 = 99,999,999 และ 9999² < 10⁸ - 1 < 10000² ดังนั้นตอบ 9999'},
    {type:'mc', skill:'Modulo', q:'perfect square เมื่อหารด้วย 4 ไม่มีทางเหลือเศษใด?', choices:['0 หรือ 1','2 หรือ 3','เฉพาะ 0','เฉพาะ 1'], ans:'2 หรือ 3', sol:'จำนวนเต็มใด ๆ เมื่อยกกำลังสองแล้วหาร 4 จะเหลือเศษได้แค่ 0 หรือ 1'}
  ]
};

function renderQuestion(q, idx, setId){
  const id = `${setId}-${idx}`;
  let body = '';
  if(q.type === 'mc'){
    body = `<div class="choices">${q.choices.map((c,i)=>`<label><input type="radio" name="${id}" value="${escapeHtml(c)}"> <span>${c}</span></label>`).join('')}</div>
      <div class="answer-line no-print"><button class="btn teal" onclick="checkQuestion('${setId}',${idx})">Check</button><button class="btn" onclick="showSolution('${id}')">Solution</button></div>`;
  } else {
    body = `<div class="answer-line"><input type="text" id="input-${id}" placeholder="พิมพ์คำตอบ เช่น 6√2 หรือ 6sqrt2"><button class="btn teal no-print" onclick="checkQuestion('${setId}',${idx})">Check</button><button class="btn no-print" onclick="showSolution('${id}')">Solution</button></div>`;
  }
  return `<div class="q" data-qid="${id}" data-done="0">
    <div class="q-head"><div class="q-title">ข้อ ${idx+1}</div><span class="skill">${q.skill}</span></div>
    <div class="q-text formula">${q.q}</div>
    ${body}
    <div id="fb-${id}" class="feedback"></div>
    <div id="sol-${id}" class="solution"><b>เฉลย:</b> <span class="formula">${q.sol}</span></div>
  </div>`;
}
function escapeHtml(str){return String(str).replace(/[&<>"]/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[s]));}
function renderSets(){
  Object.keys(sets).forEach(setId => {
    const el = document.getElementById(setId);
    el.innerHTML = sets[setId].map((q,idx)=>renderQuestion(q,idx,setId)).join('');
  });
  updateProgress();
}
function openTab(id, btn){
  $$('.tab-panel').forEach(p=>p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  $$('.tab').forEach(t=>t.classList.remove('active'));
  btn.classList.add('active');
}
function checkQuestion(setId, idx){
  const q = sets[setId][idx];
  const id = `${setId}-${idx}`;
  let ok = false;
  if(q.type === 'mc'){
    const checked = $(`input[name="${id}"]:checked`);
    ok = checked && checked.value === q.ans;
  } else {
    const value = $(`#input-${id}`).value;
    ok = accepted(value, q.ans);
  }
  const fb = $(`#fb-${id}`);
  const box = $(`[data-qid="${id}"]`);
  if(ok){
    fb.className='feedback ok';
    fb.textContent='ถูกต้อง';
    box.dataset.done='1';
  } else {
    fb.className='feedback no';
    fb.textContent='ยังไม่ถูก ลองดู perfect square หรือเงื่อนไขของสูตรอีกครั้ง';
  }
  updateProgress();
}
function showSolution(id){
  $(`#sol-${id}`).classList.toggle('show');
}
function activeSetId(){return $('.tab-panel.active')?.id || 'setA'}
function checkAllVisible(){
  const id = activeSetId();
  sets[id].forEach((_,idx)=>checkQuestion(id,idx));
}
function showSolutionsVisible(){
  const panel = document.getElementById(activeSetId());
  $$('.solution', panel).forEach(s=>s.classList.add('show'));
}
function resetAll(){
  $$('input[type="text"]').forEach(i=>i.value='');
  $$('input[type="radio"]').forEach(i=>i.checked=false);
  $$('.feedback').forEach(f=>{f.textContent='';f.className='feedback'});
  $$('.solution').forEach(s=>s.classList.remove('show'));
  $$('.q').forEach(q=>q.dataset.done='0');
  quizCorrect=0;quizTotal=0;currentQuiz=null;
  $('#quizFeedback').textContent='';$('#quizFeedback').className='feedback';
  $('#quizScore').textContent='Score: 0/0';
  $('#quizQuestion').innerHTML='<b>กด Start Quiz เพื่อเริ่มสุ่มโจทย์</b>';
  $('#quizOptions').innerHTML='';
  updateProgress();
}
function updateProgress(){
  const qs = $$('.q');
  const done = qs.filter(q=>q.dataset.done==='1').length;
  const total = qs.length;
  $('#progressText').textContent = `Progress: ${done}/${total}`;
  $('#progressBar').style.width = total ? `${Math.round(done/total*100)}%` : '0%';
}

let quizPool = [];
let currentQuiz = null;
let quizCorrect = 0;
let quizTotal = 0;
function buildQuizPool(){
  quizPool = [
    {q:'√225 = ?', choices:['13','14','15','16'], ans:'15', sol:'15² = 225'},
    {q:'√192 จัดรูปได้เป็นข้อใด?', choices:['4√12','8√3','6√2','12√2'], ans:'8√3', sol:'√192 = √(64×3) = 8√3'},
    {q:'√18 × √8 = ?', choices:['6','8','10','12'], ans:'12', sol:'√144 = 12'},
    {q:'√x² เท่ากับอะไรเสมอ?', choices:['x','-x','|x|','x²'], ans:'|x|', sol:'รากที่สองหลักไม่ติดลบ'},
    {q:'มี perfect squares กี่จำนวนตั้งแต่ 1 ถึง 500?', choices:['21','22','23','24'], ans:'22', sol:'⌊√500⌋ = 22'},
    {q:'k น้อยที่สุดที่ทำให้ 50k เป็น perfect square คือ?', choices:['2','5','10','50'], ans:'2', sol:'50 = 2×5² ต้องเติม 2'},
    {q:'⌊√999⌋ = ?', choices:['30','31','32','33'], ans:'31', sol:'31²=961 และ 32²=1024'},
    {q:'perfect square หารด้วย 4 เหลือเศษได้ข้อใด?', choices:['0 หรือ 1','1 หรือ 2','2 หรือ 3','ทุกเศษ'], ans:'0 หรือ 1', sol:'กำลังสองของจำนวนคู่เหลือ 0 ของจำนวนคี่เหลือ 1'}
  ];
}
function startQuiz(){quizCorrect=0;quizTotal=0;buildQuizPool();nextQuiz();updateQuizScore();}
function nextQuiz(){
  if(!quizPool.length) buildQuizPool();
  currentQuiz = quizPool[Math.floor(Math.random()*quizPool.length)];
  $('#quizQuestion').innerHTML = `<b class="formula">${currentQuiz.q}</b>`;
  $('#quizOptions').innerHTML = currentQuiz.choices.map((c,i)=>`<label><input type="radio" name="quiz" value="${escapeHtml(c)}"> ${c}</label>`).join('');
  $('#quizFeedback').textContent='';
  $('#quizFeedback').className='feedback';
}
function checkQuiz(){
  if(!currentQuiz){startQuiz();return;}
  const checked = $('input[name="quiz"]:checked');
  if(!checked){
    $('#quizFeedback').className='feedback no';
    $('#quizFeedback').textContent='กรุณาเลือกคำตอบก่อน';
    return;
  }
  quizTotal++;
  if(checked.value === currentQuiz.ans){
    quizCorrect++;
    $('#quizFeedback').className='feedback ok';
    $('#quizFeedback').textContent='ถูกต้อง — ' + currentQuiz.sol;
  } else {
    $('#quizFeedback').className='feedback no';
    $('#quizFeedback').textContent='ยังไม่ถูก — ' + currentQuiz.sol;
  }
  updateQuizScore();
}
function updateQuizScore(){ $('#quizScore').textContent = `Score: ${quizCorrect}/${quizTotal}`; }

renderSets();
</script>
</body>
