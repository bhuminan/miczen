    <div id="setA" class="tab-panel active exercise-set"></div>
    <div id="setB" class="tab-panel exercise-set"></div>
    <div id="setC" class="tab-panel exercise-set"></div>
    <div id="setD" class="tab-panel exercise-set"></div>
    <div id="setE" class="tab-panel exercise-set"></div>

    <div class="answer-line no-print" style="margin-top:20px">
      <button class="btn teal" onclick="checkAllVisible()">Check visible set</button>
      <button class="btn" onclick="showSolutionsVisible()">Show solutions</button>
      <button class="btn" onclick="resetAll()">Reset all</button>
    </div>
  </section>

  <section class="card" id="quiz">
    <div class="section-head">
      <div>
        <h2>6) Mini Quiz Generator</h2>
        <p class="small">สุ่มโจทย์สั้นเพื่อทบทวนก่อนสอบ เหมาะสำหรับฝึกซ้ำ 5–10 นาที</p>
      </div>
      <span class="tag">Random Drill</span>
    </div>
    <div class="quiz-box">
      <div id="quizQuestion" class="q-text"><b>กด Start Quiz เพื่อเริ่มสุ่มโจทย์</b></div>
      <div id="quizOptions" class="quiz-options"></div>
      <div class="answer-line no-print">
        <button class="btn primary" onclick="startQuiz()">Start Quiz</button>
        <button class="btn teal" onclick="checkQuiz()">Check</button>
        <button class="btn" onclick="nextQuiz()">Next</button>
